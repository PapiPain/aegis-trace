{
  "name": "aegis-trace-vscode",
  "displayName": "Maiestor Stelfid - API Route Evidence & Safe Retirement Auditor",
  "description": "Connect your API code with runtime telemetry to identify unnecessary routes and retire them with evidence, without breaking production.",
  "version": "1.4.0",
  "publisher": "aegis-trace",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PapiPain/aegis-trace.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "express",
    "nodejs",
    "security",
    "dead-code",
    "owasp",
    "api",
    "ast",
    "devsecops"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aegisTrace.scanWorkspace",
        "title": "Maiestor Stelfid: Audit Workspace Route Evidence"
      },
      {
        "command": "aegisTrace.pruneRoute",
        "title": "Maiestor Stelfid: Safe Comment Out Route"
      },
      {
        "command": "aegisTrace.keepRoute",
        "title": "Maiestor Stelfid: Mark Route as Intentional (@stelfid-keep)"
      },
      {
        "command": "aegisTrace.activateCloud",
        "title": "Maiestor Stelfid: Configure Multi-Node Telemetry"
      }
    ],
    "configuration": {
      "title": "AegisTrace SecOps",
      "properties": {
        "aegisTrace.apiKey": {
          "type": "string",
          "default": "",
          "description": "AegisTrace Cloud API Key (Pro $49/mo, Team $149/mo, Business $399/mo)."
        },
        "aegisTrace.secretKey": {
          "type": "string",
          "default": "sec_secretkey_test987",
          "description": "Zero-Knowledge HMAC-SHA256 Secret Key used to hash routes locally."
        },
        "aegisTrace.cloudUrl": {
          "type": "string",
          "default": "http://localhost:4000/v1/telemetry/hashes",
          "description": "AegisTrace Cloud or self-hosted telemetry endpoint."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  },
  "icon": "icon.png"
}
