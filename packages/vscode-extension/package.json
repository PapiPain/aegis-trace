{
  "name": "m-stelfid-vscode",
  "displayName": "Maiestor Stelfid — API Route Evidence & Safe Retirement Auditor",
  "description": "Connect your API code with runtime telemetry to identify unnecessary routes and retire them with evidence, without breaking production.",
  "version": "1.7.0-rc.1",
  "publisher": "m-stelfid",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/PapiPain/maiestor-stelfid.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "express",
    "nodejs",
    "security",
    "dead-code",
    "owasp",
    "api",
    "stelfid",
    "devsecops"
  ],
  "activationEvents": [
    "onLanguage:typescript",
    "onLanguage:javascript"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "stelfid.scanWorkspace",
        "title": "Maiestor Stelfid: Audit Workspace Route Evidence"
      },
      {
        "command": "stelfid.pruneRoute",
        "title": "Maiestor Stelfid: Safe Comment Out Route"
      },
      {
        "command": "stelfid.keepRoute",
        "title": "Maiestor Stelfid: Mark Route as Intentional (@stelfid-keep)"
      },
      {
        "command": "stelfid.deprecateRoute",
        "title": "Maiestor Stelfid: Stage Route Deprecation (@stelfid-deprecated)"
      },
      {
        "command": "stelfid.activateCloud",
        "title": "Maiestor Stelfid: Configure Multi-Node Telemetry"
      }
    ],
    "configuration": {
      "title": "Maiestor Stelfid",
      "properties": {
        "stelfid.apiKey": {
          "type": "string",
          "default": "",
          "description": "Maiestor Stelfid Cloud API Key."
        },
        "stelfid.secretKey": {
          "type": "string",
          "default": "sec_secretkey_test987",
          "description": "Zero-Knowledge HMAC-SHA256 Secret Key used to hash routes locally."
        },
        "stelfid.cloudUrl": {
          "type": "string",
          "default": "http://localhost:4000/v1/telemetry/hashes",
          "description": "Maiestor Stelfid Cloud or self-hosted telemetry endpoint."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.3"
  }
}
